# Azure Storage
# AZURE_STORAGE_CONNECTION_STRING=your_connection_string_here
# AZURE_STORAGE_CONTAINER=processos-dl

# Azure Document Intelligence (OCR avançado)
# AZURE_DOC_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com
# AZURE_DOC_INTELLIGENCE_KEY=your_key_here

# Google AI (Gemini API) – análise subsidiária por IA
# GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter – alternativa gratuita para IA (modelos free) - PADRÃO
# OPENROUTER_API_KEY=your_openrouter_api_key_here
IA_ENABLED=false
IA_PROVIDER=openrouter  # Options: "gemini" or "openrouter"
IA_MODEL=meta-llama/llama-3.3-70b-instruct:free  # Can be changed at any time via GitHub secret

# Comportamento do serviço
MAX_PDF_SIZE_MB=50
OCR_ENABLED=true
LOG_LEVEL=INFO
